      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "target", "body", "evidence"],
        "properties": {
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "target": { "type": "string" },
          "body": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "questions": { "type": "array", "items": { "type": "string" } }
  }
}
